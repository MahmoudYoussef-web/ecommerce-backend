# Local development secrets template.
# Copy this file to `.env` (gitignored) and fill in real values.
# The backend auto-loads `.env` from the repo root via:
#   spring.config.import=optional:file:.env[.properties]
#
# Generate a strong JWT secret (64 random bytes, base64):
#   openssl rand -base64 64
# or in PowerShell:
#   $b = New-Object byte[] 64; [System.Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes($b); [Convert]::ToBase64String($b)

DB_URL=jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=dev_user
DB_PASSWORD=change_me
AUTH_JWT_SECRET=1zcWFMwT57Bdcw/2/FMdk3ILZ8P91SP2Hu6mrSLYbf0=
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENT_WEBHOOK_SECRET=change_me_internal_webhook_secret

# Redis (session, rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional overrides (dev defaults shown)
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SAMESITE=Lax
APP_COOKIE_SECURE=false
APP_DEV_AUTO_VERIFY_EMAIL=true
APP_CURRENCY_EGP_PER_USD=48.75
